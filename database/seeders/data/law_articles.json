[
    {
        "id": 1,
        "law_entry_id": 1,
        "article_number": "1",
        "content": "تسري أحكام هذا النظام على كل صاحب عمل وعامل يعملان في المملكة، وفق الاستثناءات المنصوص عليها في المادة الأولى.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 2,
        "law_entry_id": 1,
        "article_number": "2",
        "content": "يجب أن يكون عقد العمل مكتوبًا، ويحدد أجر العامل ونوع العمل ومدته، على أن يُحفظ من نسختين.",
        "sort_order": 1,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 3,
        "law_entry_id": 1,
        "article_number": "3",
        "content": "يستحق العامل عند انتهاء خدمته مكافأة نهاية خدمة تُحسب على أساس أجر نصف شهر عن كل سنة من السنوات الخمس الأولى، وأجر شهر كامل عن كل سنة بعدها.",
        "sort_order": 2,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 4,
        "law_entry_id": 2,
        "article_number": "1",
        "content": "كان هذا النظام يمثل الإطار التنظيمي لعلاقات العمل قبل الإلغاء والاستبدال بنظام العمل الحالي.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 5,
        "law_entry_id": 3,
        "article_number": "1",
        "content": "يحدد هذا النظام أنواع الشركات التجارية التي يجوز تأسيسها في المملكة والأحكام العامة المشتركة بينها.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 6,
        "law_entry_id": 3,
        "article_number": "2",
        "content": "يجوز تأسيس الشركة ذات المسؤولية المحدودة من شريك واحد أو أكثر، ولا يُسأل الشريك إلا بقدر حصته في رأس المال.",
        "sort_order": 1,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 7,
        "law_entry_id": 4,
        "article_number": "1",
        "content": "يُحظر على غير السعودي ممارسة أي نشاط تجاري لم يُرخّص له بممارسته وفقًا للأنظمة ذات العلاقة.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 8,
        "law_entry_id": 5,
        "article_number": "1",
        "content": "يُطبَّق هذا النظام على المعاملات المدنية ما لم يوجد نص خاص يقضي بخلاف ذلك.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 9,
        "law_entry_id": 5,
        "article_number": "2",
        "content": "العقد شريعة المتعاقدين، فلا يجوز نقضه أو تعديله إلا باتفاق الطرفين أو للأسباب التي يقررها النظام.",
        "sort_order": 1,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 10,
        "law_entry_id": 6,
        "article_number": "1",
        "content": "لا يجوز القبض على أي إنسان أو تفتيشه أو توقيفه أو سجنه إلا في الأحوال المنصوص عليها نظامًا.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 11,
        "law_entry_id": 6,
        "article_number": "2",
        "content": "المتهم بريء حتى تثبت إدانته بحكم قضائي بات.",
        "sort_order": 1,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 12,
        "law_entry_id": 7,
        "article_number": "1",
        "content": "تختص محكمة التنفيذ دون غيرها بتنفيذ الأحكام والقرارات والسندات التنفيذية.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 13,
        "law_entry_id": 8,
        "article_number": "1",
        "content": "يشترط لصحة عقد الزواج توافر أركانه وشروطه الشرعية، ومنها الإيجاب والقبول والولي والشاهدان.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 14,
        "law_entry_id": 9,
        "article_number": "1",
        "content": "لا يجوز معالجة البيانات الشخصية إلا بموافقة صاحبها، أو في الحالات التي يحددها النظام.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    },
    {
        "id": 15,
        "law_entry_id": 10,
        "article_number": "1",
        "content": "المملكة العربية السعودية دولة عربية إسلامية ذات سيادة تامة، دينها الإسلام ودستورها كتاب الله وسنة رسوله.",
        "sort_order": 0,
        "created_at": "2026-07-30 13:32:12",
        "updated_at": "2026-07-30 13:32:12"
    }
]